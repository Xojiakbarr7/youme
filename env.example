# Required on public/production deployment
NODE_ENV=production
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_64_CHARACTER_RANDOM_SECRET

# Telegram: configure your bot token and your (or group) numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local: ./data (SQLite). On a host with persistent disk: DATA_DIR=/var/data
DATA_DIR=./data
PORT=3000
